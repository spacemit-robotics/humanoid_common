+#include <limits>
+
+namespace {
+
+uint64_t read_little_endian(const char* data, size_t width) {
+    uint64_t value = 0;
+    for(size_t index = 0; index < width; ++index) {
+        value |= static_cast<uint64_t>(
+            static_cast<unsigned char>(data[index])) << (index * 8);
+    }
+    return value;
+}
+
+void resolve_zip64_sizes(const std::vector<char>& extra,
+                         uint64_t& compressed_bytes,
+                         uint64_t& uncompressed_bytes) {
+    const uint64_t marker = std::numeric_limits<uint32_t>::max();
+    const bool needs_uncompressed = uncompressed_bytes == marker;
+    const bool needs_compressed = compressed_bytes == marker;
+    if(!needs_uncompressed && !needs_compressed) return;
+
+    size_t offset = 0;
+    while(offset + 4 <= extra.size()) {
+        const uint16_t header_id = static_cast<uint16_t>(
+            read_little_endian(extra.data() + offset, 2));
+        const size_t data_size = static_cast<size_t>(
+            read_little_endian(extra.data() + offset + 2, 2));
+        offset += 4;
+        if(offset + data_size > extra.size()) {
+            throw std::runtime_error("npz_load: malformed ZIP extra field");
+        }
+        if(header_id != 0x0001) {
+            offset += data_size;
+            continue;
+        }
+
+        size_t value_offset = offset;
+        if(needs_uncompressed) {
+            if(value_offset + 8 > offset + data_size) {
+                throw std::runtime_error("npz_load: missing ZIP64 uncompressed size");
+            }
+            uncompressed_bytes = read_little_endian(
+                extra.data() + value_offset, 8);
+            value_offset += 8;
+        }
+        if(needs_compressed) {
+            if(value_offset + 8 > offset + data_size) {
+                throw std::runtime_error("npz_load: missing ZIP64 compressed size");
+            }
+            compressed_bytes = read_little_endian(
+                extra.data() + value_offset, 8);
+        }
+        return;
+    }
+    throw std::runtime_error("npz_load: missing ZIP64 size extra field");
+}
+
+void skip_bytes(FILE* fp, uint64_t bytes) {
+    if(bytes > static_cast<uint64_t>(std::numeric_limits<long>::max()) ||
+       fseek(fp, static_cast<long>(bytes), SEEK_CUR) != 0) {
+        throw std::runtime_error("npz_load: failed to skip ZIP member");
+    }
+}
+
+}  // namespace
